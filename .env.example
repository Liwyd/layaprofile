# Copy to .env.local (or pass to the container) and adjust. Never commit real values.

# Optional GitHub personal access token used by the server for API calls.
# Without it, GitHub allows 60 requests/hour for the whole server; with a token (no scopes
# are needed for public data) the limit is 5000/hour. The token is never sent to the browser
# and never exposed by /api/health.
GITHUB_TOKEN=

# Base URL of the GitHub REST API. Leave unset for github.com; set it only for GitHub
# Enterprise Server or when pointing the app at a local mock server.
# GITHUB_API_BASE=https://api.github.com

# Set to 1 only when the app runs behind a reverse proxy you control that sets
# X-Forwarded-For. It is then used to rate limit each visitor separately. Leave unset
# otherwise: the header is client-controlled and would let anyone bypass the limit.
# TRUST_PROXY=1
