# Copy to .env and adjust. Never commit real values (.env is git-ignored).
#
# One file serves two readers:
#   - Docker Compose reads it to fill ${...} placeholders in docker-compose.yml, and passes the
#     whole file to the `app` container as its environment (env_file).
#   - For a local run without Docker (`npm run dev`), copy it to .env.local instead; Next.js
#     loads that file itself and only the app variables below apply.
# Keep DOCKERHUB_TOKEN out of this file: it would end up in the app container's environment.
# Export it in your shell for scripts/deploy.sh instead (see docs/DEPLOYMENT.md).

# ---------------------------------------------------------------------------------------------
# Deployment (read by Docker Compose)
# ---------------------------------------------------------------------------------------------

# Docker Hub account or organisation that publishes the images (the CI workflow pushes
# <namespace>/layaprofile and <namespace>/layaprofile-laya). Required by docker-compose.yml.
# For local builds (docker-compose.build.yml) any value works, for example "local".
DOCKERHUB_NAMESPACE=

# Image tag to run: latest, a release such as 1.2.3, or a commit tag such as sha-1a2b3c4 for a
# pinned deployment or a rollback. Applies to both images.
# LAYAPROFILE_TAG=latest

# Host port the app is published on, and the interface it binds to. Use APP_BIND=127.0.0.1 when
# a reverse proxy on the same host fronts the app, so the app cannot be reached around it.
# APP_PORT=3000
# APP_BIND=0.0.0.0

# Compose profiles to start. "laya" starts the local Laya inference container next to the app.
# Remove or empty this line to run the app alone, and also set LAYA_URL= (empty, below) so the
# app reports Laya as disabled instead of unreachable.
COMPOSE_PROFILES=laya

# ---------------------------------------------------------------------------------------------
# App (runtime variables, read by the server only)
# ---------------------------------------------------------------------------------------------

# Optional GitHub personal access token used by the server for API calls.
# Without it, GitHub allows 60 requests/hour for the whole server; with a token (no scopes
# are needed for public data) the limit is 5000/hour. The token is never sent to the browser
# and never exposed by /api/health.
GITHUB_TOKEN=

# Base URL of the GitHub REST API. Leave unset for github.com; set it only for GitHub
# Enterprise Server or when pointing the app at a local mock server.
# GITHUB_API_BASE=https://api.github.com

# Set to 1 ONLY when the app runs behind a reverse proxy you control that sets
# X-Forwarded-For. It is then used to rate limit each visitor separately. Leave unset
# otherwise: the header is client-controlled and would let anyone bypass the limit. Combine it
# with APP_BIND=127.0.0.1 so clients cannot reach the app directly and forge the header.
# TRUST_PROXY=1

# Base URL of the local Laya decision server (`laya-serve`, see docs/LAYA.md). docker-compose.yml
# sets it to http://laya:8000 when it is not defined here, so leave it unset for the Compose
# setup. Set it empty (LAYA_URL=) to disable Laya, or to another address for a Laya server
# outside Compose. For a local run without Docker use http://127.0.0.1:8000. When it is empty or
# unset, the app still works and shows the deterministic analysis only.
# LAYA_URL=

# Shared secret between the app and the Laya container. Generate one with
#   openssl rand -hex 32
# Compose gives the same value to both: the app sends it as `Authorization: Bearer <key>` and
# the server requires it. Leave empty to run Laya without authentication (it is only reachable
# on the private Compose network). Never logged and never exposed by /api/health.
LAYA_API_KEY=

# Milliseconds to wait for one Laya request before it counts as a failure (default 20000).
# The first request to a cold server can be slow while the checkpoint loads.
# LAYA_TIMEOUT_MS=20000

# ---------------------------------------------------------------------------------------------
# Laya container (passed to laya-serve; only used by the `laya` profile)
# ---------------------------------------------------------------------------------------------

# Torch device: cpu (default) or cuda for an NVIDIA GPU (needs a GPU image build, see
# docs/DEPLOYMENT.md).
# LAYA_DEVICE=cpu

# Cap on torch CPU threads. Keep it at or below the physical cores you give the container.
# LAYA_THREADS=2

# Checkpoints loaded at start: english, multilingual, or both comma-separated. A checkpoint that
# is not listed is not preloaded.
# LAYA_MODELS=english

# 0 (default) allows downloads from the Hugging Face Hub: required on the first start, when the
# checkpoints are not cached yet. Set it to 1 once they are cached to run without any network
# access to the Hub.
# HF_HUB_OFFLINE=0

# ---------------------------------------------------------------------------------------------
# Build time (not a runtime setting)
# ---------------------------------------------------------------------------------------------

# Public address of the site, used for the absolute Open Graph image URL. Next.js inlines it
# into the client bundle WHEN THE IMAGE IS BUILT, so setting it here at run time has no effect.
# CI passes the repository variable NEXT_PUBLIC_SITE_URL as a build argument; for a local build
# set it before `docker compose ... --build`. It is public: never put a secret in it.
# NEXT_PUBLIC_SITE_URL=https://layaprofile.example.com
